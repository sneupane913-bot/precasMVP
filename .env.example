# Copy to .env.local. The app runs with NONE of these set, using mock providers.
# Mock providers are refused in production. Set real keys before deploying.

# --- Speech to text -------------------------------------------------------
# Deepgram. BATCH mode only. Streaming costs 78% more, see docs/UNIT_ECONOMICS.md
DEEPGRAM_API_KEY=

# --- Answer evaluation ----------------------------------------------------
# Google AI Studio key for Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# --- Persistence ----------------------------------------------------------
# Leave blank to use the in-memory store (local development only).
# The in-memory store WILL LOSE DATA on Netlify. Wire these before launch.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Deferred, stubbed --------------------------------------------------
# Payments (eSewa / Khalti) and SMS OTP are deferred by decision 2026-08-05.
# The interfaces exist in lib/payments and lib/otp. Fill these in later.
ESEWA_MERCHANT_CODE=
ESEWA_SECRET_KEY=
KHALTI_SECRET_KEY=
SMS_GATEWAY_TOKEN=

# --- Cost guardrails ------------------------------------------------------
MAX_ANSWER_SECONDS=90
MAX_TRANSCRIPT_WORDS=400

# --- Three-tier access (MVP passcodes, replaced by real auth later) --------
# The owner switch has its OWN secret. A super admin cannot use it.
OWNER_ACCESS_KEY=
SUPER_ADMIN_PASSCODE=

# --- Speech to text: Groq is the default and is 2.3x cheaper than Deepgram
GROQ_API_KEY=
