# Copy to .env.local. The app runs with NONE of these set, using mock providers.
# Mock providers are refused in production. Set real keys before deploying.

# --- Speech to text -------------------------------------------------------
# Deepgram. BATCH mode only. Streaming costs 78% more, see docs/UNIT_ECONOMICS.md
DEEPGRAM_API_KEY=

# --- Answer evaluation ----------------------------------------------------
# Google AI Studio key for Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# --- Persistence ----------------------------------------------------------
# Leave blank to use the in-memory store (local development only).
# The in-memory store WILL LOSE DATA on Netlify. Wire these before launch.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Deferred, stubbed --------------------------------------------------
# Payments (eSewa / Khalti) and SMS OTP are deferred by decision 2026-08-05.
# The interfaces exist in lib/payments and lib/otp. Fill these in later.
ESEWA_MERCHANT_CODE=
ESEWA_SECRET_KEY=
KHALTI_SECRET_KEY=
SMS_GATEWAY_TOKEN=

# --- Cost guardrails ------------------------------------------------------
MAX_ANSWER_SECONDS=90
MAX_TRANSCRIPT_WORDS=400

# --- Three-tier access (MVP passcodes, replaced by real auth later) --------
# The owner switch has its OWN secret. A super admin cannot use it.
OWNER_ACCESS_KEY=
SUPER_ADMIN_PASSCODE=

# --- Speech to text: Groq is the default and is 2.3x cheaper than Deepgram
GROQ_API_KEY=

# --- Sign in with Google (the trial gate) ---------------------------------
# Three public values from your Firebase project settings.
# See docs/SETUP-GOOGLE-SIGNIN.md for the five steps.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=

# Signs the student session cookie. REQUIRED in production: the app refuses to
# start without it rather than issue forgeable cookies.
# Generate with:  openssl rand -base64 32
SESSION_SECRET=

# --- Manual QR payment ----------------------------------------------------
PAY_WALLET_NAME=eSewa
PAY_WALLET_NUMBER=
PAY_ACCOUNT_NAME=
NEXT_PUBLIC_SUPPORT_WHATSAPP=

# --- Rewards --------------------------------------------------------------
REFERRAL_LIFETIME_CAP=20

# --- Spend controls -------------------------------------------------------
MAX_PAID_CALLS_PER_MONTH=6000
MAX_MOCKS_PER_ACCOUNT_PER_DAY=12
