# iCloud conflict copies. These appear as "File 2.tsx" when iCloud cannot
# merge a change, and they WILL be compiled and deployed if committed.
# One of these ("components/InterviewRoom 2.tsx") already exists locally and
# must be deleted by hand: the folder denies programmatic deletion.
* 2.ts
* 2.tsx
* 2.js
* 3.ts
* 3.tsx
*\ [0-9].ts
*\ [0-9].tsx
diagnose-log.txt
push-log.txt
dev-output.txt

# FUSE/iCloud artefacts left behind when a synced file is replaced
.fuse_hidden*

# Scratch copies left by editors and by half-finished test runs. qa/model-check.js.tmp
# was committed by accident on 13 Aug; the push script untracks anything that
# matches this file, so it clears itself on the next push.
*.tmp

# The commit message Claude hands to SAVE-AND-PUSH.command. Not part of the product.
.commit-message.txt
